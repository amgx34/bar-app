            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorBody"
            }
          }
        }
      },
      "Error409": {
        "description": "Error envelope. Codes: conflict, stale_count.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorBody"
            }
          }
        }
      },
      "Error422": {
        "description": "Error envelope. Codes: validation_failed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorBody"
            }
          }
        }
      },
      "Error426": {
        "description": "Error envelope. Codes: upgrade_required.",
