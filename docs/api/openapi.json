{
  "openapi": "3.1.0",
  "info": {
    "title": "Rail API",
    "version": "1.0.0",
    "description": "v1 contract for the native app. Operations marked x-status: contract-only are specified but not implemented."
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "Placeholder; set by the owner."
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "summary": "The caller, their own memberships and the active bar. Needs no org header.",
        "operationId": "getMe",
        "x-status": "implemented",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Sign in with email and password.",
        "operationId": "postAuthLogin",
        "x-status": "contract-only",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Exchange a refresh token for a new session.",
        "operationId": "postAuthRefresh",
        "x-status": "contract-only",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
