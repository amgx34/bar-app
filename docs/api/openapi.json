  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "XRailOrg": {
        "name": "X-Rail-Org",
        "in": "header",
        "required": false,
        "description": "Organization id. Must be one the caller belongs to.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Client-minted UUID required on every write.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "XRequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Optional correlation id; echoed or minted.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Correlation id.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "Error envelope. Codes: org_required.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorBody"
            }
          }
        }
      },
      "Error401": {
        "description": "Error envelope. Codes: unauthenticated.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorBody"
            }
          }
        }
      },
      "Error403": {
        "description": "Error envelope. Codes: forbidden, no_membership.",
