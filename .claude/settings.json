{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npx next build*)",
      "Bash(npx eslint *)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o * http://localhost:*)"
    ],

    "ask": [
      "Read(.env)",
      "Read(.env.*)"
    ],

    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.mjs\"",
            "asyncRewake": true,
            "timeout": 90,
            "statusMessage": "Linting changed file"
          }
        ]
      }
    ]
  }
}
