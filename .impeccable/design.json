 "narrative": {
  "northStar": "The Night Manager's Clipboard",
  "overview": "Rail is a working tool for someone standing behind a bar at the end of a long night. Built to be read quickly, with one hand, on a phone, in dim light: large tabular figures, short plain-English labels, clearly bounded cards. Confident and approachable rather than austere.",
  "keyCharacteristics": [
   "Navy shell, light cool canvas, white hairline-ringed cards; a full dark theme.",
   "Monospace headings and tabular numerals: numbers are the product.",
   "One amber accent, used as a signal, never as decoration.",
   "Contrast is verified: 4.5:1 text, 3:1 control boundaries.",
   "Dense on desktop, 44px touch targets and 16px inputs on mobile.",
   "Prints cleanly: Z reports and pay runs in black on white."
  ],
  "rules": [
   {
    "name": "The One Signal Rule",
    "body": "Amber is the only warm hue. It marks the one action or label that deserves attention on a screen; never a hover color or decoration.",
    "section": "colors"
   },
   {
    "name": "The Two-Tier Border Rule",
    "body": "Decorative dividers use Hairline. Anything whose edge matters to a user uses Control Edge.",
    "section": "colors"
   },
   {
    "name": "The Navy Text Rule",
    "body": "Body and heading text is navy. Pure black text appears only in print.",
    "section": "colors"
   },
   {
    "name": "The Tabular Rule",
    "body": "Tables and anything marked .tabular use tabular figures so columns align.",
    "section": "typography"
   },
   {
    "name": "The Headings-Are-Mono Rule",
    "body": "h1 through h6 are Fira Code; body copy is never set in the mono face.",
    "section": "typography"
   },
   {
    "name": "The No-Shift Hover Rule",
    "body": "Hover states change shadow and border only; no hover moves, scales or resizes a layout.",
    "section": "elevation"
   }
  ],
  "dos": [
   "**Do** pair Signal Amber with near-black ink (#1A1206); never put white text on amber.",
   "**Do** use Amber Text (#92400E) for amber on light surfaces and #FBBF24 in dark mode.",
   "**Do** keep control boundaries at Control Edge (3:1) and decorative dividers at Hairline.",
   "**Do** set numbers in tabular figures and headings in Fira Code with ligatures off.",
   "**Do** keep hover effects to shadow and border changes; keep touch targets at 44px on mobile and inputs at 16px.",
   "**Do** reserve 9rem plus the safe-area inset at the bottom of mobile pages so the floating button never covers content.",
   "**Do** say what is missing: an empty state names what to connect rather than showing a zero."
  ],
  "donts": [
   "**Don't** use amber for hover states or purely decorative fills; it is the one signal color.",
   "**Don't** use the hairline color for an input or control edge.",
   "**Don't** let a hover transform shift layout.",
   "**Don't** hard-code colors; use the semantic tokens so the dark theme and print styles keep working.",
   "**Don't** set body copy in the mono face, or headings in Fira Sans.",
   "**Don't** nest a second `<main>` inside the app layout."
  ]
 }
}