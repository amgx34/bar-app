# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 2Touch agent — local config contains DB credentials, never commit
2touch-agent/config.local.json
2touch-agent/sync.log

# 2Touch .NET agent — local secrets + build output
2touch-agent-dotnet/appsettings.local.json
2touch-agent-dotnet/bin/
2touch-agent-dotnet/obj/
2touch-agent-dotnet/publish/
2touch-agent-dotnet/tests/**/bin/
2touch-agent-dotnet/tests/**/obj/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP session artifacts (console dumps, page snapshots)
.playwright-mcp/

# Isolated workspaces for subagent-driven plan execution
.worktrees/
