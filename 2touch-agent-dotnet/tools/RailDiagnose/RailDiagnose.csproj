<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RailDiagnose</RootNamespace>
    <AssemblyName>rail-diagnose</AssemblyName>
    <!-- Same reason as the agent: Microsoft.Data.SqlClient needs ICU, so
         InvariantGlobalization must stay off. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The checks live in the agent so the two can never drift apart. -->
    <ProjectReference Include="..\..\RailAgent.csproj" />
  </ItemGroup>

</Project>
