<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RailAgent.Apps.Update</RootNamespace>
    <AssemblyName>rail-update</AssemblyName>
    <Product>Rail 2Touch Agent Updater</Product>
    <Company>Rail</Company>
    <!-- Versioned independently of the agent. The updater changes rarely and
         the thing it reports on is the agent's version, not its own. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- References the agent project directly rather than going through an
         extracted class library. Referencing an Exe assembly is legal and the
         test project already does it, so this keeps a working 150-test build
         intact instead of restructuring every file to gain nothing. -->
    <ProjectReference Include="..\..\RailAgent.csproj" />
  </ItemGroup>

</Project>
