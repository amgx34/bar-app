<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- -windows, not plain net9.0: the setup wizard reads the registry, checks
         the Administrators role, and ACLs a file. All three live in the Windows
         targeting pack, and this has always been a Windows-only service. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RailAgent</RootNamespace>
    <AssemblyName>rail-2touch-agent</AssemblyName>

    <!-- The single source of truth for the agent's version.
         RailAgent.Setup.AgentVersion reads it back off the assembly at runtime,
         and rail-update.exe compares it against the manifest Rail publishes, so
         bumping this number here is the whole release process.
         Keep it SemVer: the updater parses it with System.Version. -->
    <Version>1.0.0</Version>
    <!-- Shown in the file properties dialog on the POS box, where an operator
         reading a version number is most likely to be looking. -->
    <Product>Rail 2Touch Agent</Product>
    <Company>Rail</Company>
    <!-- NOTE: do NOT enable InvariantGlobalization — Microsoft.Data.SqlClient
         requires ICU/globalization support and throws at connect time without it. -->
    <!-- Publish flags (RID / self-contained / single-file) are passed on the
         `dotnet publish` command line — see README — so plain `dotnet build`
         stays framework-dependent and fast to iterate on. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project and the standalone diagnostic both live under this
         directory, so keep them out of the root project's default **/*.cs glob. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <!-- rail-setup.exe, rail-update.exe and rail-uninstall.exe are separate
         executables that REFERENCE this project. They must not also be compiled
         into it, or every one of their entry points would collide with
         Program.cs. -->
    <Compile Remove="apps/**" />
    <None Remove="apps/**" />
    <EmbeddedResource Remove="apps/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Diagnostics.Bounded is the anti-hang guarantee the whole diagnose mode
         rests on, and it cannot be exercised through the public surface: a real
         SqlClient call hits its own ConnectTimeout first. -->
    <InternalsVisibleTo Include="RailAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baked into the exe so a lone .exe is a complete install. An on-disk
         appsettings.json still layers on top of it if one is present. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="RailAgent.appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied for local dev only. Publish stays one file: the wizard writes
         appsettings.local.json itself, and the defaults are embedded. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
